{
 "$defs": {
  "Agenda": {
   "additionalProperties": false,
   "properties": {
    "step": {
     "title": "Step",
     "type": "integer"
    },
    "total": {
     "title": "Total",
     "type": "integer"
    },
    "next": {
     "title": "Next",
     "type": "string"
    }
   },
   "required": [
    "step",
    "total",
    "next"
   ],
   "title": "Agenda",
   "type": "object"
  },
  "Alternative": {
   "additionalProperties": false,
   "properties": {
    "question_id": {
     "title": "Question Id",
     "type": "string"
    },
    "ig_bits": {
     "title": "Ig Bits",
     "type": "number"
    }
   },
   "required": [
    "question_id",
    "ig_bits"
   ],
   "title": "Alternative",
   "type": "object"
  },
  "AnswerRecord": {
   "additionalProperties": false,
   "properties": {
    "question_id": {
     "title": "Question Id",
     "type": "string"
    },
    "option": {
     "title": "Option",
     "type": "string"
    },
    "confidence": {
     "anyOf": [
      {
       "enum": [
        "sure",
        "unsure"
       ],
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "title": "Confidence"
    },
    "correct": {
     "title": "Correct",
     "type": "boolean"
    },
    "explanation": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Explanation"
    }
   },
   "required": [
    "question_id",
    "option",
    "confidence",
    "correct"
   ],
   "title": "AnswerRecord",
   "type": "object"
  },
  "Check": {
   "additionalProperties": false,
   "properties": {
    "name": {
     "enum": [
      "leak",
      "congruency",
      "math",
      "style"
     ],
     "title": "Name",
     "type": "string"
    },
    "status": {
     "enum": [
      "pass",
      "fail",
      "not_applicable"
     ],
     "title": "Status",
     "type": "string"
    },
    "detail": {
     "default": "",
     "title": "Detail",
     "type": "string"
    }
   },
   "required": [
    "name",
    "status"
   ],
   "title": "Check",
   "type": "object"
  },
  "Cost": {
   "additionalProperties": false,
   "properties": {
    "calls": {
     "title": "Calls",
     "type": "integer"
    },
    "cached_calls": {
     "title": "Cached Calls",
     "type": "integer"
    },
    "prompt_tokens": {
     "title": "Prompt Tokens",
     "type": "integer"
    },
    "completion_tokens": {
     "title": "Completion Tokens",
     "type": "integer"
    },
    "label": {
     "title": "Label",
     "type": "string"
    }
   },
   "required": [
    "calls",
    "cached_calls",
    "prompt_tokens",
    "completion_tokens",
    "label"
   ],
   "title": "Cost",
   "type": "object"
  },
  "GuardEvent": {
   "additionalProperties": false,
   "properties": {
    "ts": {
     "title": "Ts",
     "type": "number"
    },
    "check": {
     "enum": [
      "leak",
      "congruency",
      "math",
      "style"
     ],
     "title": "Check",
     "type": "string"
    },
    "status": {
     "enum": [
      "pass",
      "fail"
     ],
     "title": "Status",
     "type": "string"
    },
    "action": {
     "enum": [
      "shown",
      "regenerated",
      "fallback"
     ],
     "title": "Action",
     "type": "string"
    },
    "summary": {
     "title": "Summary",
     "type": "string"
    }
   },
   "required": [
    "ts",
    "check",
    "status",
    "action",
    "summary"
   ],
   "title": "GuardEvent",
   "type": "object"
  },
  "HypProb": {
   "additionalProperties": false,
   "properties": {
    "id": {
     "enum": [
      "M0",
      "M1",
      "M2",
      "M3",
      "M4"
     ],
     "title": "Id",
     "type": "string"
    },
    "name_en": {
     "title": "Name En",
     "type": "string"
    },
    "prob": {
     "maximum": 1,
     "minimum": 0,
     "title": "Prob",
     "type": "number"
    }
   },
   "required": [
    "id",
    "name_en",
    "prob"
   ],
   "title": "HypProb",
   "type": "object"
  },
  "NextQuestion": {
   "additionalProperties": false,
   "properties": {
    "question_id": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "title": "Question Id"
    },
    "ig_bits": {
     "title": "Ig Bits",
     "type": "number"
    },
    "alternatives": {
     "items": {
      "$ref": "#/$defs/Alternative"
     },
     "title": "Alternatives",
     "type": "array"
    },
    "entropy_bits": {
     "title": "Entropy Bits",
     "type": "number"
    },
    "stop": {
     "title": "Stop",
     "type": "boolean"
    },
    "stop_reason": {
     "anyOf": [
      {
       "enum": [
        "threshold",
        "max_questions",
        "no_questions"
       ],
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "title": "Stop Reason"
    }
   },
   "required": [
    "question_id",
    "ig_bits",
    "alternatives",
    "entropy_bits",
    "stop",
    "stop_reason"
   ],
   "title": "NextQuestion",
   "type": "object"
  },
  "QuestionView": {
   "additionalProperties": false,
   "description": "A question as shown to the student. Never contains the answer key or option mappings.",
   "properties": {
    "id": {
     "title": "Id",
     "type": "string"
    },
    "text": {
     "title": "Text",
     "type": "string"
    },
    "options": {
     "additionalProperties": {
      "type": "string"
     },
     "title": "Options",
     "type": "object"
    },
    "requires_confidence": {
     "default": true,
     "title": "Requires Confidence",
     "type": "boolean"
    },
    "why_mode": {
     "default": "free",
     "enum": [
      "free",
      "structured"
     ],
     "title": "Why Mode",
     "type": "string"
    },
    "why_options": {
     "default": [],
     "items": {
      "$ref": "#/$defs/SafeText"
     },
     "title": "Why Options",
     "type": "array"
    }
   },
   "required": [
    "id",
    "text",
    "options"
   ],
   "title": "QuestionView",
   "type": "object"
  },
  "SafeText": {
   "additionalProperties": false,
   "description": "Every piece of text the frontend may display. Render ONLY if shown_allowed is true.",
   "properties": {
    "text": {
     "title": "Text",
     "type": "string"
    },
    "lang": {
     "default": "en",
     "enum": [
      "fr",
      "ar",
      "en"
     ],
     "title": "Lang",
     "type": "string"
    },
    "origin": {
     "enum": [
      "llm",
      "verified_bank",
      "template"
     ],
     "title": "Origin",
     "type": "string"
    },
    "checks": {
     "items": {
      "$ref": "#/$defs/Check"
     },
     "title": "Checks",
     "type": "array"
    },
    "shown_allowed": {
     "title": "Shown Allowed",
     "type": "boolean"
    },
    "fallback_used": {
     "default": false,
     "title": "Fallback Used",
     "type": "boolean"
    }
   },
   "required": [
    "text",
    "origin",
    "checks",
    "shown_allowed"
   ],
   "title": "SafeText",
   "type": "object"
  }
 },
 "additionalProperties": false,
 "properties": {
  "contract_version": {
   "default": "1.0",
   "title": "Contract Version",
   "type": "string"
  },
  "session_id": {
   "title": "Session Id",
   "type": "string"
  },
  "student": {
   "additionalProperties": true,
   "title": "Student",
   "type": "object"
  },
  "profile": {
   "additionalProperties": {
    "anyOf": [
     {
      "type": "boolean"
     },
     {
      "type": "integer"
     },
     {
      "type": "string"
     }
    ]
   },
   "title": "Profile",
   "type": "object"
  },
  "demo_mode": {
   "title": "Demo Mode",
   "type": "boolean"
  },
  "state": {
   "enum": [
    "DIAGNOSE",
    "HINT_1",
    "HINT_2",
    "HINT_3",
    "RECONSTRUCT",
    "TRANSFER",
    "DONE",
    "HANDOFF"
   ],
   "title": "State",
   "type": "string"
  },
  "agenda": {
   "$ref": "#/$defs/Agenda"
  },
  "posterior": {
   "items": {
    "$ref": "#/$defs/HypProb"
   },
   "title": "Posterior",
   "type": "array"
  },
  "top": {
   "$ref": "#/$defs/HypProb"
  },
  "asked": {
   "items": {
    "$ref": "#/$defs/AnswerRecord"
   },
   "title": "Asked",
   "type": "array"
  },
  "current_question": {
   "anyOf": [
    {
     "$ref": "#/$defs/QuestionView"
    },
    {
     "type": "null"
    }
   ]
  },
  "next_question": {
   "$ref": "#/$defs/NextQuestion"
  },
  "fragile": {
   "items": {
    "type": "string"
   },
   "title": "Fragile",
   "type": "array"
  },
  "guard_events": {
   "items": {
    "$ref": "#/$defs/GuardEvent"
   },
   "title": "Guard Events",
   "type": "array"
  },
  "cost": {
   "$ref": "#/$defs/Cost"
  },
  "warnings": {
   "default": [],
   "items": {
    "type": "string"
   },
   "title": "Warnings",
   "type": "array"
  }
 },
 "required": [
  "session_id",
  "student",
  "profile",
  "demo_mode",
  "state",
  "agenda",
  "posterior",
  "top",
  "asked",
  "current_question",
  "next_question",
  "fragile",
  "guard_events",
  "cost"
 ],
 "title": "SessionState",
 "type": "object"
}